# Copie para backend/.env e preencha. NUNCA commite o .env real.

# Postgres do Supabase — use a string do "Session pooler" (Project Settings > Database > Connect)
# Para rodar local sem Supabase, pode deixar o padrão SQLite: sqlite:///./rubrica.db
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth (Project Settings > API)
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# URL(s) do frontend liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,https://rubrica.vercel.app

# Recall.ai (dashboard > API Keys). Região = a do seu dashboard (ex.: us-west-2.recall.ai -> us-west-2)
RECALL_API_KEY=sua-chave-recall
RECALL_REGION=us-west-2
RECALL_TRANSCRIPT_LANGUAGE=pt
RECALL_DELETE_MEDIA=true
# Qualquer texto aleatório longo; vai na URL do webhook: /api/webhooks/recall?token=ESTE_VALOR
WEBHOOK_TOKEN=troque-por-um-texto-aleatorio-longo

# IA que gera a rubrica — qualquer API compatível com OpenAI.
# Groq (grátis): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sua-chave-groq
LLM_MODEL=openai/gpt-oss-120b
# Alternativa grátis — Google Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
MAX_TRANSCRIPT_CHARS=40000
